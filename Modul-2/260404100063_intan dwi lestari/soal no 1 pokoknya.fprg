<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="soal no 1 pokoknya"/>
        <attribute name="authors" value="Lenovo"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 06:07:17 PM"/>
        <attribute name="created" value="TGVub3ZvO0xBUFRPUC1OT0lUQ1Q2TTsyMDI2LTEwLTA3OzA1OjI4OjA2IFBNOzMwMTU="/>
        <attribute name="edited" value="TGVub3ZvO0xBUFRPUC1OT0lUQ1Q2TTsyMDI2LTEwLTA3OzA2OjA3OjE3IFBNOzE7MzEyMw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, d1, d2, d3, pelacak" type="Integer" array="False" size=""/>
            <output expression="&quot;masukkan 3 digit kode&quot;" newline="True"/>
            <input variable="kode"/>
            <assign variable="d1" expression="kode / 100"/>
            <assign variable="d2" expression="(kode / 10) %  10"/>
            <assign variable="d3" expression="kode % 10"/>
            <assign variable="pelacak" expression="d1 * d3"/>
            <output expression="&quot;Digit: &quot; &amp; d1 &amp; &quot;, &quot; &amp; d2 &amp; &quot;, &quot; &amp; d3 &amp; &quot; | Pelacak awal: &quot; &amp; pelacak" newline="True"/>
            <if expression="d2 % 2 = 0">
                <then>
                    <assign variable="pelacak" expression="pelacak + 25"/>
                </then>
                <else>
                    <assign variable="pelacak" expression="pelacak - d2"/>
                </else>
            </if>
            <output expression="&quot;Setelah tahap 1: &quot; &amp; pelacak" newline="True"/>
            <if expression="pelacak % 3 = 0">
                <then>
                    <assign variable="pelacak" expression="pelacak / 3"/>
                </then>
                <else>
                    <assign variable="pelacak" expression="pelacak * 2"/>
                </else>
            </if>
            <output expression="&quot;pelacakAkhir:&quot; &amp; pelacak" newline="True"/>
            <if expression="pelacak &gt; 50">
                <then>
                    <output expression="&quot;kategori A&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="pelacak &gt;20">
                        <then>
                            <output expression="&quot;kategori B&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;password Ditolak&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="pelacak % 2 =0">
                <then>
                    <output expression="&quot;siklus genap&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;siklus genap&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
